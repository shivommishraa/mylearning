Options -Indexes

<IfModule php_module>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^index\.php$ - [L]
    RewriteRule ^\.well-known(?:/|$) - [L]
    RewriteRule ^public(?:/|$) - [L]

    RewriteRule ^(?:[^/]+/)*(build|images|storage)(/.*)?$ public/$1$2 [L]
    RewriteRule ^(?:[^/]+/)*(favicon\.ico|robots\.txt)$ public/$1 [L]

    RewriteRule ^.*$ index.php [L]
</IfModule>
